{
  "name": "port-pilot",
  "version": "1.0.27",
  "description": "Kill stuck local ports, format JSON, and query databases — a developer workstation for Mac and Windows.",
  "homepage": "https://apps.apple.com/app/portpilot-desktop/id6801225932?mt=12",
  "main": "./out/main/index.js",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b --pretty false --noEmit",
    "pack": "electron-vite build && bun run dist:mac",
    "dist:mac": "node scripts/ensure-node.cjs && node node_modules/electron-builder/cli.js --mac",
    "dist:mas": "node scripts/ensure-node.cjs && node scripts/dist-mas.cjs",
    "pack:mas": "electron-vite build && bun run dist:mas",
    "dist:win": "node scripts/ensure-node.cjs && node node_modules/electron-builder/cli.js --win --x64",
    "postinstall": "electron-builder install-app-deps",
    "bench": "bun run build && python3 scripts/bench-baseline.py"
  },
  "build": {
    "appId": "com.portpilot.app",
    "productName": "PortPilot",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "out",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "electronFuses": {
      "enableCookieEncryption": false
    },
    "afterPack": "./scripts/after-pack.cjs",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "mas": {
      "type": "distribution",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "entitlementsLoginHelper": "build/entitlements.mas.loginhelper.plist",
      "preAutoEntitlements": false,
      "provisioningProfile": "build/embedded.provisionprofile",
      "identity": "Shailesh Jha (ARDSWV5GD2)",
      "bundleShortVersion": "1.0.23",
      "bundleVersion": "5",
      "extendInfo": {
        "ElectronTeamID": "ARDSWV5GD2",
        "ITSAppUsesNonExemptEncryption": false,
        "NSHumanReadableCopyright": "2026 Shailesh Jha"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": true
    },
    "dmg": {
      "sign": true
    },
    "publish": {
      "provider": "github",
      "owner": "Shailesh200",
      "repo": "PortPilot",
      "releaseType": "draft"
    },
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@electron-toolkit/utils": "^4.0.0",
    "@lezer/highlight": "^1.2.3",
    "@libsql/client": "^0.14.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@uiw/react-codemirror": "^4.25.11",
    "clsx": "^2.1.0",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.13",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "fast-xml-parser": "^5.10.1",
    "fuse.js": "^7.0.0",
    "js-yaml": "^5.2.3",
    "json-diff-kit": "^1.0.35",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.1",
    "marked": "^18.0.9",
    "mongodb": "^6.21.0",
    "mysql2": "^3.23.2",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "^6.2.108",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "read-excel-file": "^9.3.10",
    "redis": "^6.2.0",
    "smol-toml": "^1.7.1",
    "sql.js": "^1.14.1",
    "ssh2": "^1.17.0",
    "turndown": "^7.2.4",
    "write-excel-file": "^4.1.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/diff": "^7.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.11",
    "@types/ssh2": "^1.15.5",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "40.10.6",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
